# Copy to .env for local development. Values here are placeholders.
# Publishable (anon) key + URL are safe in the browser; the service-role key is NOT.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-side only (server functions / webhooks). Never expose to the client bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Cron endpoints (Bearer token). Previously LOVABLE_CRON_SECRET.
RENTID_CRON_SECRET=

# Envelope encryption master keys: <key-id>:<base64 32 bytes>, newest first.
RENTID_ENCRYPTION_KEYS=

# Admin console gate for /admin/prospects (legacy; superseded by the admin role once real auth ships)
RENTID_ADMIN_ACCESS_CODE=change-me

# Payments (sandbox). Leave empty until a provider is chosen; the app runs with the
# built-in sandbox adapter when unset. See src/lib/payments/README.md
PAYMENTS_PROVIDER=sandbox
PAYMENTS_WEBHOOK_SECRET=change-me

# Local Postgres used by scripts/db/*.sh and the RLS test-suite
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rentid_local

# Build-time only: set to 1 to attach rentid.online / www as Worker custom domains
# (bun run deploy:live does this). Leave unset until the zone is active on Cloudflare.
# DEPLOY_CUSTOM_DOMAIN=1
